PORT=5000
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-url>/info-quiz?retryWrites=true&w=majority&appName=info-quiz
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-url>/info-quiz?retryWrites=true&w=majority&appName=info-quiz
# Optional if your URI does not already include the database name.
MONGODB_DB_NAME=info-quiz
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
